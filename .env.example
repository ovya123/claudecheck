# Copy to .env and fill in.

# Local: SQLite file. Production: Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=sqlite:///./classbridge.db
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# gemini | openai | mock   (mock = canned offline answers; never use for the demo)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Your Next.js origin(s), comma-separated. "*" allows everything (fine for the hackathon).
CORS_ORIGINS=http://localhost:3000
